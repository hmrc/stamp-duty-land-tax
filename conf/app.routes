# microservice specific routes

GET         /manage-agents/agent-details/get                uk.gov.hmrc.stampdutylandtax.controllers.agents.ManageAgentsController.getAgentDetails(storn: String, agentReferenceNumber: String)
POST        /manage-agents/agent-details/submit             uk.gov.hmrc.stampdutylandtax.controllers.agents.ManageAgentsController.submitAgentDetails
GET         /manage-agents/agent-details/get-all-agents     uk.gov.hmrc.stampdutylandtax.controllers.agents.ManageAgentsController.getAllAgentsLegacy(storn: String)
GET         /manage-agents/agent-details/remove             uk.gov.hmrc.stampdutylandtax.controllers.agents.ManageAgentsController.removeAgent(storn: String, agentReferenceNumber: String)

# Dummy response in line with formp schema
GET         /manage-agents/get-sdlt-organisation            uk.gov.hmrc.stampdutylandtax.controllers.agents.ManageAgentsController.getSdltOrganisation(storn: String)

GET         /manage-returns/get-returns                     uk.gov.hmrc.stampdutylandtax.controllers.manage.ManageReturnsController.getReturns(storn: String)

# Filing Routes

POST        /filing/create/return                           uk.gov.hmrc.stampdutylandtax.controllers.FilingReturnsController.createReturn()
