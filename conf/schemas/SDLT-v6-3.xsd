  <xsd:element name="IRenvelope">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element minOccurs="1" maxOccurs="1" ref="sdlt:IRheader"/>
        <xsd:element minOccurs="1" maxOccurs="1" ref="sdlt:SDLT"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="IRheader">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element minOccurs="0" maxOccurs="1" name="TestMessage">
          <xsd:simpleType>
            <xsd:restriction base="xsd:int">
              <xsd:maxInclusive value="9"/>
              <xsd:minInclusive value="0"/>
            </xsd:restriction>
          </xsd:simpleType>
        </xsd:element>
        <xsd:element minOccurs="0" maxOccurs="1" name="Keys">
          <xsd:annotation>
            <xsd:documentation>This element contains identifiers for the sender of the message. Each identifier is contained within a &lt;Key&gt; element. Each &lt;Key&gt; element also contains a 'Type' attribute which describes the identifier type (e.g. &lt;Key Type='UTR'&gt;, &lt;Key Type='TaxOfficeNumber'&gt;, &lt;Key Type='TaxOfficeReference'&gt;).</xsd:documentation>
          </xsd:annotation>
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element minOccurs="1" maxOccurs="unbounded" name="Key">
                <xsd:complexType>
                  <xsd:simpleContent>
                    <xsd:extension base="sdlt:SDLT_IRheaderStringType">
                      <xsd:attribute use="optional" name="Type" type="sdlt:SDLT_IRheaderStringType"/>
                    </xsd:extension>
                  </xsd:simpleContent>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        <xsd:element minOccurs="1" maxOccurs="1" name="PeriodEnd" type="xsd:date"/>
        <xsd:element minOccurs="0" maxOccurs="1" name="Principal">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element minOccurs="1" maxOccurs="1" name="Contact" type="sdlt:SDLT_ContactDetailsStructure"/>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        <xsd:element minOccurs="0" maxOccurs="1" name="Agent">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element minOccurs="0" maxOccurs="1" name="AgentID">
                <xsd:annotation>
                  <xsd:documentation>This identifier is for the agent's own reference and is not the same as any agent's credentials that might be used to identify the agent to the Government Gateway.</xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                  <xsd:restriction base="sdlt:SDLT_IRheaderStringType">
                    <xsd:minLength value="1"/>
                    <xsd:maxLength value="35"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element minOccurs="0" maxOccurs="1" name="Company">
                <xsd:simpleType>
                  <xsd:restriction base="sdlt:SDLT_IRheaderStringType">
                    <xsd:minLength value="1"/>
                    <xsd:maxLength value="35"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element minOccurs="0" maxOccurs="1" name="Address">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element minOccurs="1" maxOccurs="4" name="Line">
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:minLength value="1"/>
                          <xsd:maxLength value="35"/>
                          <xsd:pattern value="[A-Za-z0-9 ~!&quot;@#$%&amp;&apos;\(\)\*\+,\-\./:;&lt;=&gt;\?\[\\\]^_\{\}£€]*"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element minOccurs="0" maxOccurs="1" name="PostCode">
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:minLength value="1"/>
                          <xsd:maxLength value="8"/>
                          <xsd:pattern value="[A-Za-z0-9 ~!&quot;@#$%&amp;&apos;\(\)\*\+,\-\./:;&lt;=&gt;\?\[\\\]^_\{\}£€]*"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element minOccurs="0" maxOccurs="1" name="Country">
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:minLength value="1"/>
                          <xsd:maxLength value="35"/>
                          <xsd:pattern value="[A-Za-z0-9 ~!&quot;@#$%&amp;&apos;\(\)\*\+,\-\./:;&lt;=&gt;\?\[\\\]^_\{\}£€]*"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element minOccurs="0" maxOccurs="1" name="Contact" type="sdlt:SDLT_ContactDetailsStructure"/>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        <xsd:element minOccurs="0" maxOccurs="1" name="DefaultCurrency">
          <xsd:simpleType>
            <xsd:restriction base="sdlt:SDLT_ISOcurrencyType">
              <xsd:enumeration value="GBP">
                <xsd:annotation>
                  <xsd:documentation>GBP</xsd:documentation>
                </xsd:annotation>
              </xsd:enumeration>
            </xsd:restriction>
          </xsd:simpleType>
        </xsd:element>
        <xsd:element minOccurs="0" maxOccurs="1" name="Manifest">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element minOccurs="1" maxOccurs="1" name="Contains">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element minOccurs="1" maxOccurs="unbounded" name="Reference">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element minOccurs="1" maxOccurs="1" name="Namespace" type="xsd:anyURI"/>
                          <xsd:element minOccurs="1" maxOccurs="1" name="SchemaVersion">
                            <xsd:simpleType>
                              <xsd:restriction base="sdlt:SDLT_IRheaderStringType">
                                <xsd:maxLength value="13"/>
                                <xsd:pattern value="[0-9]{4}\-v[0-9]{1,3}\.[0-9]{1,3}(\.[0-9]{1,3})?"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element minOccurs="1" maxOccurs="1" name="TopElementName" type="xsd:NCName"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        <xsd:element minOccurs="0" maxOccurs="1" name="IRmark">
          <xsd:complexType>
            <xsd:simpleContent>
              <xsd:extension base="xsd:string">
                <xsd:attribute use="required" name="Type">
                  <xsd:simpleType>
                    <xsd:restriction base="sdlt:SDLT_IRheaderStringType">
                      <xsd:enumeration value="SAonly">
                        <xsd:annotation>
                          <xsd:documentation>SAonly</xsd:documentation>
                        </xsd:annotation>
                      </xsd:enumeration>
                      <xsd:enumeration value="generic">
                        <xsd:annotation>
                          <xsd:documentation>generic</xsd:documentation>
                        </xsd:annotation>
                      </xsd:enumeration>
                    </xsd:restriction>
                  </xsd:simpleType>
                </xsd:attribute>
              </xsd:extension>
            </xsd:simpleContent>
          </xsd:complexType>
        </xsd:element>
        <xsd:element minOccurs="1" maxOccurs="1" name="Sender">
          <xsd:simpleType>
            <xsd:restriction base="xsd:string">
              <xsd:enumeration value="Individual">
                <xsd:annotation>
                  <xsd:documentation>Individual</xsd:documentation>
                </xsd:annotation>
              </xsd:enumeration>
              <xsd:enumeration value="Company">
                <xsd:annotation>
                  <xsd:documentation>Company</xsd:documentation>
                </xsd:annotation>
              </xsd:enumeration>
              <xsd:enumeration value="Agent">
                <xsd:annotation>
                  <xsd:documentation>Agent</xsd:documentation>
                </xsd:annotation>
              </xsd:enumeration>
              <xsd:enumeration value="Bureau">
                <xsd:annotation>
                  <xsd:documentation>Bureau</xsd:documentation>
                </xsd:annotation>
              </xsd:enumeration>
              <xsd:enumeration value="Partnership">
                <xsd:annotation>
                  <xsd:documentation>Partnership</xsd:documentation>
                </xsd:annotation>
              </xsd:enumeration>
              <xsd:enumeration value="Trust">
                <xsd:annotation>
                  <xsd:documentation>Trust</xsd:documentation>
                </xsd:annotation>
              </xsd:enumeration>
              <xsd:enumeration value="Employer">
                <xsd:annotation>
                  <xsd:documentation>Employer</xsd:documentation>
                </xsd:annotation>
              </xsd:enumeration>
              <xsd:enumeration value="Government">
                <xsd:annotation>
                  <xsd:documentation>Government</xsd:documentation>
                </xsd:annotation>
              </xsd:enumeration>
              <xsd:enumeration value="Acting in Capacity">
                <xsd:annotation>
                  <xsd:documentation>Acting in Capacity</xsd:documentation>
                </xsd:annotation>
              </xsd:enumeration>
              <xsd:enumeration value="Other">
                <xsd:annotation>
                  <xsd:documentation>Other</xsd:documentation>
                </xsd:annotation>
              </xsd:enumeration>
            </xsd:restriction>
          </xsd:simpleType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="SDLT">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element minOccurs="0" maxOccurs="1" name="UTRN" type="sdlt:SDUTRNtype">
          <xsd:annotation>
            <xsd:documentation>Unique Transaction Reference Number</xsd:documentation>
          </xsd:annotation>
        </xsd:element>
        <xsd:element minOccurs="1" maxOccurs="1" name="TransactionDetails">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element minOccurs="1" maxOccurs="1" name="TransactionDescription">
                <xsd:simpleType>
                  <xsd:restriction base="xsd:string">
                    <xsd:enumeration value="F"/>
                    <xsd:enumeration value="L"/>
                    <xsd:enumeration value="O"/>
                    <xsd:enumeration value="A"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element minOccurs="1" maxOccurs="1" name="EffectiveDate">
                <xsd:simpleType>
                  <xsd:restriction base="sdlt:SDpastDateType">
                    <xsd:minInclusive value="2003-12-01"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element minOccurs="1" maxOccurs="1" name="RestrictionsAffecting">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element minOccurs="0" maxOccurs="1" name="Details">
                      <xsd:simpleType>
                        <xsd:restriction base="sdlt:SDalphaNumericType">
                          <xsd:maxLength value="42"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                  </xsd:sequence>
                  <xsd:attribute use="required" name="Apply" type="sdlt:SDLT_YesNoType"/>
                </xsd:complexType>
              </xsd:element>
              <xsd:element minOccurs="0" maxOccurs="1" name="ContractDate" type="sdlt:SDpastDateType"/>
              <xsd:element minOccurs="1" maxOccurs="1" name="LandExchanged">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element minOccurs="0" maxOccurs="1" name="Address" type="sdlt:SDaddressType"/>
                  </xsd:sequence>
                  <xsd:attribute use="required" name="Exchanged" type="sdlt:SDLT_YesNoType"/>
                </xsd:complexType>
              </xsd:element>
              <xsd:element minOccurs="1" maxOccurs="1" name="PursuantToOption" type="sdlt:SDLT_YesNoType">
                <xsd:annotation>
                  <xsd:documentation>Is the transaction pursuant to a previous option agreement? (Field 8)</xsd:documentation>
                </xsd:annotation>
              </xsd:element>
              <xsd:element minOccurs="1" maxOccurs="1" name="TaxCalculation">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element minOccurs="1" maxOccurs="1" name="ClaimingRelief">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element minOccurs="0" maxOccurs="1" name="Reason">
                            <xsd:simpleType>
                              <xsd:restriction base="xsd:integer">
                                <xsd:pattern value="0[5789]|[12][0-9]|3[0-8]"/>
                                <xsd:maxInclusive value="38"/>
                                <xsd:minInclusive value="05"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element minOccurs="0" maxOccurs="1" name="SchemeNumber">
                            <xsd:simpleType>
                              <xsd:restriction base="sdlt:SDstringType">
                                <xsd:maxLength value="14"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element minOccurs="0" maxOccurs="1" name="ChargeableAmount" type="sdlt:SDmonetaryStructure"/>
                        </xsd:sequence>
                        <xsd:attribute use="required" name="Claiming" type="sdlt:SDLT_YesNoType"/>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element minOccurs="0" maxOccurs="1" name="Consideration">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element minOccurs="1" maxOccurs="1" name="TotalConsideration" type="sdlt:SDmonetaryStructure"/>
                          <xsd:element minOccurs="0" maxOccurs="1" name="VATamount" type="sdlt:SDmonetaryStructure"/>
                          <xsd:element minOccurs="0" maxOccurs="4" name="FormCode">
                            <xsd:simpleType>
                              <xsd:restriction base="xsd:integer">
                                <xsd:maxInclusive value="39"/>
                                <xsd:minInclusive value="30"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element minOccurs="1" maxOccurs="1" name="LinkedTransaction">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element minOccurs="0" maxOccurs="1" name="LinkedTotal" type="sdlt:SDmonetaryStructure"/>
                        </xsd:sequence>
                        <xsd:attribute use="required" name="IsLinked" type="sdlt:SDLT_YesNoType"/>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element minOccurs="1" maxOccurs="1" name="TotalDue" type="sdlt:SDmonetaryStructure"/>
                    <xsd:element minOccurs="1" maxOccurs="1" name="AmountPaid">
                      <xsd:complexType>
                        <xsd:simpleContent>
                          <xsd:extension base="sdlt:SDmonetaryStructure">
                            <xsd:attribute use="required" name="IncludesPenalties" type="sdlt:SDLT_YesNoType"/>
                          </xsd:extension>
                        </xsd:simpleContent>
                      </xsd:complexType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        <xsd:element minOccurs="1" maxOccurs="1" name="LandDetail">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element minOccurs="1" maxOccurs="1" name="NumberOfProperties">
                <xsd:simpleType>
                  <xsd:restriction base="xsd:integer">
                    <xsd:maxInclusive value="99"/>
                    <xsd:minInclusive value="1"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element minOccurs="0" maxOccurs="1" name="CertificateForEach" type="sdlt:SDLT_YesNoType"/>
              <xsd:element minOccurs="0" maxOccurs="1" name="LeaseDetails">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element minOccurs="0" maxOccurs="1" name="LeaseType">
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:enumeration value="M"/>
                          <xsd:enumeration value="N"/>
                          <xsd:enumeration value="R"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element minOccurs="0" maxOccurs="1" name="StartDate" type="sdlt:SDleaseStartDateType">
                      <xsd:annotation>
                        <xsd:documentation>Start date as specified in lease</xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                    <xsd:element minOccurs="0" maxOccurs="1" name="EndDate">
                      <xsd:annotation>
                        <xsd:documentation>End date as specified in lease</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="sdlt:SDLT_DateType">
                          <xsd:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2}"/>
                          <xsd:minInclusive value="2003-12-01"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element minOccurs="0" maxOccurs="1" name="RentFreePeriod">
                      <xsd:annotation>
                        <xsd:documentation>Length of rent-free period in months.</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:integer">
                          <xsd:pattern value="[0-9][0-9]"/>
                          <xsd:maxInclusive value="99"/>
                          <xsd:minInclusive value="01"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element minOccurs="0" maxOccurs="1" name="StartingRent">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element minOccurs="0" maxOccurs="1" name="RentPayable">
                            <xsd:annotation>
                              <xsd:documentation>Annual starting rent inclusive of VAT (actually) payable</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                              <xsd:restriction base="sdlt:SDmonetaryStructure">
                                <xsd:maxInclusive value="99999999.00"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element minOccurs="0" maxOccurs="1" name="EndDate">
                            <xsd:annotation>
                              <xsd:documentation>End date for starting rent if known</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                              <xsd:restriction base="sdlt:SDLT_DateType">
                                <xsd:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2}"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element minOccurs="0" maxOccurs="1" name="LaterRentKnown" type="sdlt:SDLT_YesNoType"/>
                          <xsd:element minOccurs="0" maxOccurs="1" name="VATamount">
                            <xsd:simpleType>
                              <xsd:restriction base="sdlt:SDmonetaryStructure">
                                <xsd:maxInclusive value="999999999.00"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element minOccurs="0" maxOccurs="1" name="PremiumPaid" type="sdlt:SDmonetaryStructure"/>
                    <xsd:element minOccurs="0" maxOccurs="1" name="NetPresentValue" type="sdlt:SDmonetaryStructure"/>
                    <xsd:element minOccurs="0" maxOccurs="1" name="TotalPremiumTax" type="sdlt:SDmonetaryStructure"/>
                    <xsd:element minOccurs="0" maxOccurs="1" name="TotalNPVtax" type="sdlt:SDmonetaryStructure"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element minOccurs="1" maxOccurs="1" name="Property">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element minOccurs="1" maxOccurs="1" name="PropertyType">
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:integer">
                          <xsd:pattern value="[0-9][0-9]"/>
                          <xsd:enumeration value="01">
                            <xsd:annotation>
                              <xsd:documentation>Residential</xsd:documentation>
                            </xsd:annotation>
                          </xsd:enumeration>
                          <xsd:enumeration value="02">
                            <xsd:annotation>
                              <xsd:documentation>Mixed</xsd:documentation>
                            </xsd:annotation>
                          </xsd:enumeration>
                          <xsd:enumeration value="03">
                            <xsd:annotation>
                              <xsd:documentation>Non-residential</xsd:documentation>
                            </xsd:annotation>
                          </xsd:enumeration>
                          <xsd:enumeration value="04">
                            <xsd:annotation>
                              <xsd:documentation>Additional Residential Property Liable to Higher Rate</xsd:documentation>
                            </xsd:annotation>
                          </xsd:enumeration>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element minOccurs="1" maxOccurs="1" name="AddressOfLand">
                      <xsd:complexType>
                        <xsd:complexContent>
                          <xsd:extension base="sdlt:SDaddressType">
                            <xsd:attribute use="required" name="AddressExtended">
                              <xsd:simpleType>
                                <xsd:restriction base="sdlt:SDLT_YesNoType">
                                  <xsd:enumeration value="no">
                                    <xsd:annotation>
                                      <xsd:documentation>No</xsd:documentation>
                                    </xsd:annotation>
                                  </xsd:enumeration>
                                </xsd:restriction>
                              </xsd:simpleType>
                            </xsd:attribute>
                          </xsd:extension>
                        </xsd:complexContent>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element minOccurs="1" maxOccurs="1" ref="sdlt:LAnumber"/>
                    <xsd:element minOccurs="0" maxOccurs="1" name="TitleNumber">
                      <xsd:simpleType>
                        <xsd:restriction base="sdlt:SDstringType">
                          <xsd:maxLength value="14"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element minOccurs="0" maxOccurs="1" ref="sdlt:NLPGUPRN"/>
                    <xsd:element minOccurs="0" maxOccurs="1" ref="sdlt:LandArea"/>
                    <xsd:element minOccurs="1" maxOccurs="1" name="PlanSubmitted" type="sdlt:SDLT_YesNoType">
                      <xsd:annotation>
                        <xsd:documentation>Is a plan attached/Will a plan be submitted separately in the case of electronic submission?</xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                    <xsd:element minOccurs="1" maxOccurs="1" name="InterestTransfered">
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:enumeration value="OT"/>
                          <xsd:enumeration value="FP"/>
                          <xsd:enumeration value="FG"/>
                          <xsd:enumeration value="FT"/>
                          <xsd:enumeration value="LP"/>
                          <xsd:enumeration value="LG"/>
                          <xsd:enumeration value="LT"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element minOccurs="0" maxOccurs="1" name="AddressExtension" type="sdlt:SDlongAddressType"/>
              <xsd:element minOccurs="0" maxOccurs="unbounded" name="AdditionalProperty">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element minOccurs="1" maxOccurs="1" name="PropertyType">
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:integer">
                          <xsd:pattern value="[0-9][0-9]"/>
                          <xsd:enumeration value="01">
                            <xsd:annotation>
                              <xsd:documentation>Residential</xsd:documentation>
                            </xsd:annotation>
                          </xsd:enumeration>
                          <xsd:enumeration value="02">
                            <xsd:annotation>
                              <xsd:documentation>Mixed</xsd:documentation>
                            </xsd:annotation>
                          </xsd:enumeration>
                          <xsd:enumeration value="03">
                            <xsd:annotation>
                              <xsd:documentation>Non-residential</xsd:documentation>
                            </xsd:annotation>
                          </xsd:enumeration>
                          <xsd:enumeration value="04">
                            <xsd:annotation>
                              <xsd:documentation>Additional Residential Property Liable to Higher Rate</xsd:documentation>
                            </xsd:annotation>
                          </xsd:enumeration>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element minOccurs="1" maxOccurs="1" ref="sdlt:LAnumber"/>
                    <xsd:element minOccurs="0" maxOccurs="1" name="TitleNumber">
                      <xsd:simpleType>
                        <xsd:restriction base="sdlt:SDstringType">
                          <xsd:maxLength value="14"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element minOccurs="0" maxOccurs="1" ref="sdlt:NLPGUPRN"/>
                    <xsd:element minOccurs="1" maxOccurs="1" name="AddressOfLand" type="sdlt:SDlongAddressType"/>
                    <xsd:element minOccurs="0" maxOccurs="1" ref="sdlt:LandArea"/>
                    <xsd:element minOccurs="0" maxOccurs="1" name="PlanSubmitted" type="sdlt:SDLT_YesNoType">
                      <xsd:annotation>
                        <xsd:documentation>Is a plan attached/Will a plan be submitted separately in the case of electronic submission?</xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                    <xsd:element minOccurs="1" maxOccurs="1" name="InterestTransfered">
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:enumeration value="OT"/>
                          <xsd:enumeration value="FP"/>
                          <xsd:enumeration value="FG"/>
                          <xsd:enumeration value="FT"/>
                          <xsd:enumeration value="LP"/>
                          <xsd:enumeration value="LG"/>
                          <xsd:enumeration value="LT"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element minOccurs="0" maxOccurs="1" name="MineralRights" type="sdlt:SDLT_YesNoType"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        <xsd:element minOccurs="1" maxOccurs="1" name="VendorDetails">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element minOccurs="1" maxOccurs="1" name="NumberOfVendors">
                <xsd:simpleType>
                  <xsd:restriction base="xsd:integer">
                    <xsd:maxInclusive value="99"/>
                    <xsd:minInclusive value="1"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element minOccurs="1" maxOccurs="1" name="Vendor">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element minOccurs="1" maxOccurs="1" name="Name">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element minOccurs="0" maxOccurs="1" name="Title">
                            <xsd:simpleType>
                              <xsd:restriction base="sdlt:SDstringType">
                                <xsd:minLength value="1"/>
                                <xsd:maxLength value="6"/>
                                <xsd:pattern value="[A-Za-z ]*"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element minOccurs="0" maxOccurs="2" name="Forename">
                            <xsd:simpleType>
                              <xsd:restriction base="sdlt:SDstringType">
                                <xsd:minLength value="1"/>
                                <xsd:maxLength value="14"/>
                                <xsd:pattern value="[A-Za-z][A-Za-z ]*"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element minOccurs="1" maxOccurs="1" name="CompanyOrSurname">
                            <xsd:simpleType>
                              <xsd:restriction base="sdlt:SDstringType">
                                <xsd:minLength value="1"/>
                                <xsd:maxLength value="56"/>
                                <xsd:pattern value="\S.*"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element minOccurs="1" maxOccurs="1" name="Address" type="sdlt:SDaddressType"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element minOccurs="0" maxOccurs="1" name="AgentDetails">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element minOccurs="1" maxOccurs="1" name="Name">
                      <xsd:simpleType>
                        <xsd:restriction base="sdlt:SDstringType">
                          <xsd:maxLength value="28"/>
                          <xsd:pattern value="\S.*"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element minOccurs="0" maxOccurs="1" name="Address" type="sdlt:SDaddressType"/>
                    <xsd:element minOccurs="0" maxOccurs="1" name="DXnumber">
                      <xsd:simpleType>
                        <xsd:restriction base="sdlt:SDalphaNumericType">
                          <xsd:maxLength value="28"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element minOccurs="0" maxOccurs="1" name="EmailAddress">
                      <xsd:simpleType>
                        <xsd:restriction base="sdlt:SDLT_EmailType">
                          <xsd:maxLength value="36"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element minOccurs="0" maxOccurs="1" name="Reference">
                      <xsd:simpleType>
                        <xsd:restriction base="sdlt:SDstringType">
                          <xsd:maxLength value="14"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element minOccurs="0" maxOccurs="1" name="Telephone">
                      <xsd:simpleType>
                        <xsd:restriction base="sdlt:SDstringType">
                          <xsd:maxLength value="14"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element minOccurs="0" maxOccurs="1" name="AdditionalVendor">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element minOccurs="1" maxOccurs="1" name="Name" type="sdlt:SDnameStructure"/>
                    <xsd:choice minOccurs="1" maxOccurs="1">
                      <xsd:element minOccurs="1" maxOccurs="1" name="SameAddressAsPrimaryVendor">
                        <xsd:simpleType>
                          <xsd:restriction base="sdlt:SDLT_YesNoType">
                            <xsd:enumeration value="yes">
                              <xsd:annotation>
                                <xsd:documentation>This is the same address as the primary vendor</xsd:documentation>
                              </xsd:annotation>
                            </xsd:enumeration>
                          </xsd:restriction>
                        </xsd:simpleType>
                      </xsd:element>
                      <xsd:element minOccurs="1" maxOccurs="1" name="Address" type="sdlt:SDaddressType"/>
                    </xsd:choice>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element minOccurs="0" maxOccurs="unbounded" name="SDLT2Vendor">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element minOccurs="1" maxOccurs="1" name="Name" type="sdlt:SDnameStructure"/>
                    <xsd:element minOccurs="1" maxOccurs="1" name="Address" type="sdlt:SDaddressType"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        <xsd:element minOccurs="1" maxOccurs="1" name="PurchaserDetails">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element minOccurs="1" maxOccurs="1" name="NumberOfPurchasers">
                <xsd:simpleType>
                  <xsd:restriction base="xsd:integer">
                    <xsd:maxInclusive value="99"/>
                    <xsd:minInclusive value="1"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element minOccurs="0" maxOccurs="1" name="ResidencyStatus" type="sdlt:SDLT_YesNoType"/>
              <xsd:element minOccurs="0" maxOccurs="1" name="CloseCompanyStatus" type="sdlt:SDLT_YesNoType"/>
              <xsd:element minOccurs="0" maxOccurs="1" name="CrownEmployeeRelief" type="sdlt:SDLT_YesNoType"/>
              <xsd:element minOccurs="1" maxOccurs="1" name="Purchaser">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element minOccurs="1" maxOccurs="1" name="Name" type="sdlt:SDnameStructure"/>
                    <xsd:choice minOccurs="1" maxOccurs="1">
                      <xsd:element minOccurs="1" maxOccurs="1" name="Address" type="sdlt:SDaddressType"/>
                      <xsd:element minOccurs="1" maxOccurs="1" name="SameAddressAsLand">
                        <xsd:simpleType>
                          <xsd:restriction base="sdlt:SDLT_YesNoType">
                            <xsd:enumeration value="yes">
                              <xsd:annotation>
                                <xsd:documentation>This is the same address as the address of the land.</xsd:documentation>
                              </xsd:annotation>
                            </xsd:enumeration>
                          </xsd:restriction>
                        </xsd:simpleType>
                      </xsd:element>
                    </xsd:choice>
                    <xsd:element minOccurs="0" maxOccurs="1" name="NINO">
                      <xsd:annotation>
                        <xsd:documentation>National insurance number for first purchaser if they are an individual and have one</xsd:documentation>
                      </xsd:annotation>
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:minLength value="8"/>
                          <xsd:maxLength value="9"/>
                          <xsd:pattern value="[A-CEGHJ-PR-TW-Z][A-CEGHJ-NPR-TW-Z][0-9]{6}[A-D]?"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element minOccurs="0" maxOccurs="1" name="DateOfBirth">
                      <xsd:simpleType>
                        <xsd:restriction base="sdlt:SDLT_DateType">
                          <xsd:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2}"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element minOccurs="1" maxOccurs="1" name="Trustee" type="sdlt:SDLT_YesNoType">
                      <xsd:annotation>
                        <xsd:documentation>Is the purchaser acting as a trustee?</xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                    <xsd:element minOccurs="0" maxOccurs="1" name="Telephone">
                      <xsd:simpleType>
                        <xsd:restriction base="sdlt:SDstringType">
                          <xsd:maxLength value="14"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element minOccurs="1" maxOccurs="1" name="VendorConnected" type="sdlt:SDLT_YesNoType">
                      <xsd:annotation>
                        <xsd:documentation>Are the purchaser and vendor connected?</xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                    <xsd:element minOccurs="1" maxOccurs="1" name="CertificateAddress">
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:enumeration value="Agent">
                            <xsd:annotation>
                              <xsd:documentation>Send certificate to the Agent</xsd:documentation>
                            </xsd:annotation>
                          </xsd:enumeration>
                          <xsd:enumeration value="Purchaser">
                            <xsd:annotation>
                              <xsd:documentation>Send certificate to the Purchaser</xsd:documentation>
                            </xsd:annotation>
                          </xsd:enumeration>
                          <xsd:enumeration value="Property">
                            <xsd:annotation>
                              <xsd:documentation>Send certificate to the Land</xsd:documentation>
                            </xsd:annotation>
                          </xsd:enumeration>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element minOccurs="1" maxOccurs="1" name="AuthoriseAgent" type="sdlt:SDLT_YesNoType">
                      <xsd:annotation>
                        <xsd:documentation>I authorise the agent to handle correspondence on my behalf</xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                    <xsd:element minOccurs="0" maxOccurs="1" name="AgentDetails">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element minOccurs="1" maxOccurs="1" name="Name">
                            <xsd:simpleType>
                              <xsd:restriction base="sdlt:SDstringType">
                                <xsd:maxLength value="28"/>
                                <xsd:pattern value="\S.*"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element minOccurs="0" maxOccurs="1" name="Address" type="sdlt:SDaddressType"/>
                          <xsd:element minOccurs="0" maxOccurs="1" name="DXnumber">
                            <xsd:simpleType>
                              <xsd:restriction base="sdlt:SDalphaNumericType">
                                <xsd:maxLength value="28"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element minOccurs="0" maxOccurs="1" name="Reference">
                            <xsd:simpleType>
                              <xsd:restriction base="sdlt:SDstringType">
                                <xsd:maxLength value="14"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element minOccurs="0" maxOccurs="1" name="Telephone">
                            <xsd:simpleType>
                              <xsd:restriction base="sdlt:SDstringType">
                                <xsd:maxLength value="14"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element minOccurs="0" maxOccurs="1" name="AdditionalPurchaser">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element minOccurs="1" maxOccurs="1" name="Name" type="sdlt:SDnameStructure"/>
                    <xsd:choice minOccurs="1" maxOccurs="1">
                      <xsd:element minOccurs="1" maxOccurs="1" name="Address" type="sdlt:SDaddressType"/>
                      <xsd:element minOccurs="1" maxOccurs="1" name="SameAddressAsPrimaryPurchaser">
                        <xsd:simpleType>
                          <xsd:restriction base="sdlt:SDLT_YesNoType">
                            <xsd:enumeration value="yes">
                              <xsd:annotation>
                                <xsd:documentation>This is the same address as the primary purchaser</xsd:documentation>
                              </xsd:annotation>
                            </xsd:enumeration>
                          </xsd:restriction>
                        </xsd:simpleType>
                      </xsd:element>
                    </xsd:choice>
                    <xsd:element minOccurs="1" maxOccurs="1" name="Trustee" type="sdlt:SDLT_YesNoType"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element minOccurs="0" maxOccurs="unbounded" name="SDLT2Purchaser">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element minOccurs="1" maxOccurs="1" name="Name" type="sdlt:SDnameStructure"/>
                    <xsd:element minOccurs="1" maxOccurs="1" name="Address" type="sdlt:SDaddressType"/>
                    <xsd:element minOccurs="1" maxOccurs="1" name="Trustee" type="sdlt:SDLT_YesNoType">
                      <xsd:annotation>
                        <xsd:documentation>Is the purchaser acting as a trustee?</xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                    <xsd:element minOccurs="1" maxOccurs="1" name="VendorConnected" type="sdlt:SDLT_YesNoType">
                      <xsd:annotation>
                        <xsd:documentation>Are the purchaser and vendor connected?</xsd:documentation>
                      </xsd:annotation>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        <xsd:element minOccurs="1" maxOccurs="1" name="SupplementarySections">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element minOccurs="1" maxOccurs="1" name="SDLT2Count">
                <xsd:simpleType>
                  <xsd:restriction base="xsd:integer">
                    <xsd:maxInclusive value="99"/>
                    <xsd:minInclusive value="0"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element minOccurs="1" maxOccurs="1" name="SDLT3Count">
                <xsd:simpleType>
                  <xsd:restriction base="xsd:integer">
                    <xsd:maxInclusive value="99"/>
                    <xsd:minInclusive value="0"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
              <xsd:element minOccurs="1" maxOccurs="1" name="SDLT4Count">
                <xsd:simpleType>
                  <xsd:restriction base="xsd:integer">
                    <xsd:maxInclusive value="99"/>
                    <xsd:minInclusive value="0"/>
                  </xsd:restriction>
                </xsd:simpleType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
        <xsd:element minOccurs="0" maxOccurs="unbounded" name="SDLT4">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="AdditionalTransactionDetails">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element minOccurs="0" maxOccurs="1" name="TotalConsideration">
                      <xsd:complexType>
                        <xsd:simpleContent>
                          <xsd:extension base="sdlt:SDmonetaryStructure">
                            <xsd:attribute use="required" name="Stock" type="sdlt:SDLT_YesNoType"/>
                            <xsd:attribute use="required" name="Goodwill" type="sdlt:SDLT_YesNoType"/>
                            <xsd:attribute use="required" name="Other" type="sdlt:SDLT_YesNoType"/>
                            <xsd:attribute use="required" name="ChattelsAndMoveables" type="sdlt:SDLT_YesNoType"/>
                          </xsd:extension>
                        </xsd:simpleContent>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element minOccurs="0" maxOccurs="1" name="PropertyUse">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element minOccurs="0" maxOccurs="1" name="Office">
                            <xsd:simpleType>
                              <xsd:restriction base="sdlt:SDLT_YesNoType">
                                <xsd:enumeration value="yes">
                                  <xsd:annotation>
                                    <xsd:documentation>Office use</xsd:documentation>
                                  </xsd:annotation>
                                </xsd:enumeration>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element minOccurs="0" maxOccurs="1" name="Hotel">
                            <xsd:simpleType>
                              <xsd:restriction base="sdlt:SDLT_YesNoType">
                                <xsd:enumeration value="yes">
                                  <xsd:annotation>
                                    <xsd:documentation>Hotel use</xsd:documentation>
                                  </xsd:annotation>
                                </xsd:enumeration>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element minOccurs="0" maxOccurs="1" name="Shop">
                            <xsd:simpleType>
                              <xsd:restriction base="sdlt:SDLT_YesNoType">
                                <xsd:enumeration value="yes">
                                  <xsd:annotation>
                                    <xsd:documentation>Shop use</xsd:documentation>
                                  </xsd:annotation>
                                </xsd:enumeration>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element minOccurs="0" maxOccurs="1" name="Warehouse">
                            <xsd:simpleType>
                              <xsd:restriction base="sdlt:SDLT_YesNoType">
                                <xsd:enumeration value="yes">
                                  <xsd:annotation>
                                    <xsd:documentation>Warehouse use</xsd:documentation>
                                  </xsd:annotation>
                                </xsd:enumeration>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element minOccurs="0" maxOccurs="1" name="Factory">
                            <xsd:simpleType>
                              <xsd:restriction base="sdlt:SDLT_YesNoType">
                                <xsd:enumeration value="yes">
                                  <xsd:annotation>
                                    <xsd:documentation>Factory use</xsd:documentation>
                                  </xsd:annotation>
                                </xsd:enumeration>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element minOccurs="0" maxOccurs="1" name="Other">
                            <xsd:simpleType>
                              <xsd:restriction base="sdlt:SDLT_YesNoType">
                                <xsd:enumeration value="yes">
                                  <xsd:annotation>
                                    <xsd:documentation>Other use</xsd:documentation>
                                  </xsd:annotation>
                                </xsd:enumeration>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element minOccurs="0" maxOccurs="1" name="OtherIndustrialUnit">
                            <xsd:simpleType>
                              <xsd:restriction base="sdlt:SDLT_YesNoType">
                                <xsd:enumeration value="yes">
                                  <xsd:annotation>
                                    <xsd:documentation>Other industrial use</xsd:documentation>
                                  </xsd:annotation>
                                </xsd:enumeration>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element minOccurs="0" maxOccurs="1" name="PostTransactionRuling" type="sdlt:SDLT_YesNoType"/>
                    <xsd:element minOccurs="0" maxOccurs="1" name="PostTransactionRulingFollowed">
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                          <xsd:enumeration value="yes">
                            <xsd:annotation>
                              <xsd:documentation>The post transaction ruling has been followed.</xsd:documentation>
                            </xsd:annotation>
                          </xsd:enumeration>
                          <xsd:enumeration value="no">
                            <xsd:annotation>
                              <xsd:documentation>The post transaction ruling has not been followed.</xsd:documentation>
                            </xsd:annotation>
                          </xsd:enumeration>
                          <xsd:enumeration value="RulingNotReceived">
                            <xsd:annotation>
                              <xsd:documentation>The post transaction ruling has not been received.</xsd:documentation>
                            </xsd:annotation>
                          </xsd:enumeration>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element minOccurs="0" maxOccurs="1" name="ConsiderationDependentOnFutureEvents" type="sdlt:SDLT_YesNoType"/>
                    <xsd:element minOccurs="0" maxOccurs="1" name="DeferredPayment" type="sdlt:SDLT_YesNoType"/>
                    <xsd:element minOccurs="0" maxOccurs="1" name="MineralRights" type="sdlt:SDLT_YesNoType"/>
                    <xsd:element minOccurs="0" maxOccurs="1" name="PurchaserVATreferenceNumber">
                      <xsd:simpleType>
                        <xsd:restriction base="sdlt:SDstringType">
                          <xsd:minLength value="9"/>
                          <xsd:maxLength value="9"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                    <xsd:element minOccurs="0" maxOccurs="1" name="PurchaserCompanyDetails">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element minOccurs="0" maxOccurs="1" name="TaxReferenceNumber">
                            <xsd:simpleType>
                              <xsd:restriction base="sdlt:SDstringType">
                                <xsd:minLength value="1"/>
                                <xsd:maxLength value="10"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element minOccurs="0" maxOccurs="1" name="CompanyRegisteredNumber">
                            <xsd:simpleType>
                              <xsd:restriction base="sdlt:SDstringType">
                                <xsd:minLength value="1"/>
                                <xsd:maxLength value="14"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element minOccurs="0" maxOccurs="1" name="PlaceOfRegistration">
                            <xsd:simpleType>
                              <xsd:restriction base="sdlt:SDstringType">
                                <xsd:minLength value="1"/>
                                <xsd:maxLength value="28"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element minOccurs="0" maxOccurs="4" name="PurchaserDescription">
                      <xsd:simpleType>
                        <xsd:restriction base="xsd:integer">
                          <xsd:pattern value="[0-9][0-9]"/>
                          <xsd:maxInclusive value="15"/>
                          <xsd:minInclusive value="01"/>
                        </xsd:restriction>
                      </xsd:simpleType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element minOccurs="0" maxOccurs="1" name="AboutTheLease">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element minOccurs="0" maxOccurs="1" name="Property">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element minOccurs="1" maxOccurs="1" name="PropertyType">
                            <xsd:simpleType>
                              <xsd:restriction base="xsd:integer">
                                <xsd:pattern value="[0-9][0-9]"/>
                                <xsd:enumeration value="01">
                                  <xsd:annotation>
                                    <xsd:documentation>Residential</xsd:documentation>
                                  </xsd:annotation>
                                </xsd:enumeration>
                                <xsd:enumeration value="02">
                                  <xsd:annotation>
                                    <xsd:documentation>Mixed</xsd:documentation>
                                  </xsd:annotation>
                                </xsd:enumeration>
                                <xsd:enumeration value="03">
                                  <xsd:annotation>
                                    <xsd:documentation>Non-residential</xsd:documentation>
                                  </xsd:annotation>
                                </xsd:enumeration>
                                <xsd:enumeration value="04">
                                  <xsd:annotation>
                                    <xsd:documentation>Additional Residential Property Liable to Higher Rate</xsd:documentation>
                                  </xsd:annotation>
                                </xsd:enumeration>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:choice minOccurs="0" maxOccurs="1">
                            <xsd:element minOccurs="1" maxOccurs="1" name="SameAddressAsSDLT1">
                              <xsd:simpleType>
                                <xsd:restriction base="sdlt:SDLT_YesNoType">
                                  <xsd:enumeration value="yes">
                                    <xsd:annotation>
                                      <xsd:documentation>This is the same address as SDLT1 box 28</xsd:documentation>
                                    </xsd:annotation>
                                  </xsd:enumeration>
                                </xsd:restriction>
                              </xsd:simpleType>
                            </xsd:element>
                            <xsd:element minOccurs="1" maxOccurs="1" name="AddressOfLand" type="sdlt:SDlongAddressType"/>
                          </xsd:choice>
                          <xsd:element minOccurs="0" maxOccurs="1" ref="sdlt:LAnumber"/>
                          <xsd:element minOccurs="0" maxOccurs="1" name="TitleNumber">
                            <xsd:simpleType>
                              <xsd:restriction base="sdlt:SDstringType">
                                <xsd:maxLength value="14"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element minOccurs="0" maxOccurs="1" ref="sdlt:NLPGUPRN"/>
                          <xsd:element minOccurs="0" maxOccurs="1" ref="sdlt:LandArea"/>
                          <xsd:element minOccurs="0" maxOccurs="1" name="PlanSubmitted" type="sdlt:SDLT_YesNoType">
                            <xsd:annotation>
                              <xsd:documentation>Will a plan be submitted separately?</xsd:documentation>
                            </xsd:annotation>
                          </xsd:element>
                          <xsd:element minOccurs="0" maxOccurs="1" name="InterestTransfered">
                            <xsd:simpleType>
                              <xsd:restriction base="xsd:string">
                                <xsd:enumeration value="OT"/>
                                <xsd:enumeration value="FG"/>
                                <xsd:enumeration value="FP"/>
                                <xsd:enumeration value="FT"/>
                                <xsd:enumeration value="LP"/>
                                <xsd:enumeration value="LG"/>
                                <xsd:enumeration value="LT"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element minOccurs="0" maxOccurs="1" name="LeaseDetails">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element minOccurs="0" maxOccurs="1" name="LeaseType">
                            <xsd:simpleType>
                              <xsd:restriction base="xsd:string">
                                <xsd:enumeration value="M"/>
                                <xsd:enumeration value="N"/>
                                <xsd:enumeration value="R"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element minOccurs="0" maxOccurs="1" name="StartDate" type="sdlt:SDleaseStartDateType">
                            <xsd:annotation>
                              <xsd:documentation>Start date as specified in lease</xsd:documentation>
                            </xsd:annotation>
                          </xsd:element>
                          <xsd:element minOccurs="0" maxOccurs="1" name="EndDate">
                            <xsd:annotation>
                              <xsd:documentation>End date as specified in lease</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                              <xsd:restriction base="sdlt:SDLT_DateType">
                                <xsd:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2}"/>
                                <xsd:minInclusive value="2003-12-01"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element minOccurs="0" maxOccurs="1" name="RentFreePeriod">
                            <xsd:annotation>
                              <xsd:documentation>Length of rent-free period in months.</xsd:documentation>
                            </xsd:annotation>
                            <xsd:simpleType>
                              <xsd:restriction base="xsd:integer">
                                <xsd:pattern value="[0-9][0-9]"/>
                                <xsd:maxInclusive value="99"/>
                                <xsd:minInclusive value="01"/>
                              </xsd:restriction>
                            </xsd:simpleType>
                          </xsd:element>
                          <xsd:element minOccurs="0" maxOccurs="1" name="StartingRent">
                            <xsd:complexType>
                              <xsd:sequence>
                                <xsd:element minOccurs="0" maxOccurs="1" name="RentPayable">
                                  <xsd:annotation>
                                    <xsd:documentation>Annual starting rent inclusive of VAT (actually) payable</xsd:documentation>
                                  </xsd:annotation>
                                  <xsd:simpleType>
                                    <xsd:restriction base="sdlt:SDmonetaryStructure">
                                      <xsd:maxInclusive value="99999999.00"/>
                                    </xsd:restriction>
                                  </xsd:simpleType>
                                </xsd:element>
                                <xsd:element minOccurs="0" maxOccurs="1" name="EndDate">
                                  <xsd:annotation>
                                    <xsd:documentation>End date for starting rent if known</xsd:documentation>
                                  </xsd:annotation>
                                  <xsd:simpleType>
                                    <xsd:restriction base="sdlt:SDLT_DateType">
                                      <xsd:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2}"/>
                                    </xsd:restriction>
                                  </xsd:simpleType>
                                </xsd:element>
                                <xsd:element minOccurs="0" maxOccurs="1" name="LaterRentKnown" type="sdlt:SDLT_YesNoType"/>
                                <xsd:element minOccurs="0" maxOccurs="1" name="VATamount">
                                  <xsd:simpleType>
                                    <xsd:restriction base="sdlt:SDmonetaryStructure">
                                      <xsd:maxInclusive value="999999999.00"/>
                                    </xsd:restriction>
                                  </xsd:simpleType>
                                </xsd:element>
                              </xsd:sequence>
                            </xsd:complexType>
                          </xsd:element>
                          <xsd:element minOccurs="0" maxOccurs="1" name="PremiumPaid" type="sdlt:SDmonetaryStructure"/>
                          <xsd:element minOccurs="0" maxOccurs="1" name="NetPresentValue" type="sdlt:SDmonetaryStructure"/>
                          <xsd:element minOccurs="0" maxOccurs="1" name="TotalPremiumTax" type="sdlt:SDmonetaryStructure"/>
                          <xsd:element minOccurs="0" maxOccurs="1" name="TotalNPVtax" type="sdlt:SDmonetaryStructure"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="LAnumber">
    <xsd:simpleType>
      <xsd:restriction base="xsd:integer">
        <xsd:pattern value="[0-9]{4}"/>
      </xsd:restriction>
    </xsd:simpleType>
  </xsd:element>
  <xsd:element name="NLPGUPRN">
    <xsd:simpleType>
      <xsd:restriction base="sdlt:SDalphaNumericType">
        <xsd:maxLength value="14"/>
        <xsd:pattern value="(NI)?[0-9]+"/>
      </xsd:restriction>
    </xsd:simpleType>
  </xsd:element>
  <xsd:element name="LandArea">
    <xsd:complexType>
      <xsd:simpleContent>
        <xsd:extension base="sdlt:_intermediate_SDLandArea">
          <xsd:attribute use="required" name="Unit">
            <xsd:simpleType>
              <xsd:restriction base="xsd:string">
                <xsd:enumeration value="SquareMetres">
                  <xsd:annotation>
                    <xsd:documentation>Measurement is in Square metres</xsd:documentation>
                  </xsd:annotation>
                </xsd:enumeration>
                <xsd:enumeration value="Hectares">
                  <xsd:annotation>
                    <xsd:documentation>Measurement is in Hectares</xsd:documentation>
                  </xsd:annotation>
                </xsd:enumeration>
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:attribute>
        </xsd:extension>
      </xsd:simpleContent>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="PostCode">
    <xsd:simpleType>
      <xsd:restriction base="xsd:string">
        <xsd:maxLength value="8"/>
        <xsd:pattern value="[A-Z]([0-9]|[0-9]{2}|([A-HJ-Y][0-9]{1,2})|([0-9][A-Z])|([A-HJ-Y][0-9]?[A-Z])) [0-9][ABD-HJLNP-UW-Z]{2}"/>
      </xsd:restriction>
    </xsd:simpleType>
  </xsd:element>
  <xsd:complexType name="SDaddressType">
    <xsd:sequence>
      <xsd:element minOccurs="0" maxOccurs="1" ref="sdlt:PostCode"/>
      <xsd:element minOccurs="0" maxOccurs="1" name="HouseNumber">
        <xsd:simpleType>
          <xsd:restriction base="sdlt:SDalphaNumericType">
            <xsd:maxLength value="4"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element minOccurs="1" maxOccurs="4" name="Line">
        <xsd:simpleType>
          <xsd:restriction base="sdlt:SDstringType">
            <xsd:minLength value="1"/>
            <xsd:maxLength value="35"/>
            <xsd:pattern value="\S.*"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="SDlongAddressType">
    <xsd:sequence>
      <xsd:element minOccurs="0" maxOccurs="1" ref="sdlt:PostCode"/>
      <xsd:element minOccurs="0" maxOccurs="1" name="HouseNumber">
        <xsd:simpleType>
          <xsd:restriction base="sdlt:SDalphaNumericType">
            <xsd:maxLength value="4"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element minOccurs="1" maxOccurs="18" name="Line">
        <xsd:simpleType>
          <xsd:restriction base="sdlt:SDstringType">
            <xsd:minLength value="1"/>
            <xsd:maxLength value="35"/>
            <xsd:pattern value="\S.*"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:simpleType name="SDstringType">
    <xsd:restriction base="xsd:string">
      <xsd:pattern value="[A-Za-z0-9 ~!@%&amp;&apos;\(\)\*\+,\-\./:;=\?\[\]^_\{\}]*"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="SDleaseStartDateType">
    <xsd:restriction base="sdlt:SDLT_DateType">
      <xsd:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2}"/>
      <xsd:minInclusive value="1500-01-01"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="SDpastDateType">
    <xsd:restriction base="sdlt:SDLT_DateType">
      <xsd:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2}"/>
      <xsd:minInclusive value="1900-01-01"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:complexType name="SDnameStructure">
    <xsd:sequence>
      <xsd:element minOccurs="0" maxOccurs="1" name="Title">
        <xsd:simpleType>
          <xsd:restriction base="sdlt:SDstringType">
            <xsd:minLength value="1"/>
            <xsd:maxLength value="6"/>
            <xsd:pattern value="[A-Za-z ]*"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element minOccurs="0" maxOccurs="2" name="Forename">
        <xsd:simpleType>
          <xsd:restriction base="sdlt:SDstringType">
            <xsd:minLength value="1"/>
            <xsd:maxLength value="14"/>
            <xsd:pattern value="\S.*"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element minOccurs="1" maxOccurs="1" name="CompanyOrSurname">
        <xsd:simpleType>
          <xsd:restriction base="sdlt:SDstringType">
            <xsd:minLength value="1"/>
            <xsd:maxLength value="56"/>
            <xsd:pattern value="\S.*"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:simpleType name="SDalphaNumericType">
    <xsd:restriction base="xsd:string">
      <xsd:pattern value="[A-Za-z0-9\. ]*"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="SDmonetaryStructure">
    <xsd:restriction base="xsd:decimal">
      <xsd:pattern value="(([1-9][0-9]*)|0)\.0{2}"/>
      <xsd:maxInclusive value="9999999999.00"/>
      <xsd:minInclusive value="0.00"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="SDUTRNtype">
    <xsd:annotation>
      <xsd:documentation>Unique Transaction Reference Number</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:string">
      <xsd:pattern value="[0-9]{9}M[A-HJ-NP-TV-Z]"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:complexType name="SDLT_ContactDetailsStructure">
    <xsd:sequence>
      <xsd:element minOccurs="0" maxOccurs="1" name="Name">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element minOccurs="0" maxOccurs="1" name="Ttl">
              <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                  <xsd:minLength value="1"/>
                  <xsd:maxLength value="4"/>
                  <xsd:pattern value="[A-Za-z][A-Za-z&apos;\-]*"/>
                </xsd:restriction>
              </xsd:simpleType>
            </xsd:element>
            <xsd:element minOccurs="1" maxOccurs="2" name="Fore">
              <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                  <xsd:minLength value="1"/>
                  <xsd:maxLength value="35"/>
                  <xsd:pattern value="[A-Za-z][A-Za-z&apos;\-]*"/>
                </xsd:restriction>
              </xsd:simpleType>
            </xsd:element>
            <xsd:element minOccurs="1" maxOccurs="1" name="Sur">
              <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                  <xsd:minLength value="1"/>
                  <xsd:maxLength value="35"/>
                  <xsd:pattern value="[A-Za-z0-9 ,\.\(\)/&amp;\-&apos;]+"/>
                </xsd:restriction>
              </xsd:simpleType>
            </xsd:element>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element minOccurs="0" maxOccurs="unbounded" name="Email">
        <xsd:complexType>
          <xsd:simpleContent>
            <xsd:extension base="sdlt:SDLT_EmailType">
              <xsd:attribute use="optional" name="Type" type="sdlt:SDLT_WorkHomeType"/>
              <xsd:attribute use="optional" name="Preferred" type="sdlt:SDLT_YesNoType"/>
            </xsd:extension>
          </xsd:simpleContent>
        </xsd:complexType>
      </xsd:element>
      <xsd:element minOccurs="0" maxOccurs="unbounded" name="Telephone" type="sdlt:SDLT_TelephoneStructure"/>
      <xsd:element minOccurs="0" maxOccurs="unbounded" name="Fax" type="sdlt:SDLT_TelephoneStructure"/>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:simpleType name="SDLT_DateType">
    <xsd:annotation>
      <xsd:documentation>The date is in the Common Era (minus sign in years is not permitted)</xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:date">
      <xsd:pattern value="\d{4}-\d{2}-\d{2}"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="SDLT_EmailType">
    <xsd:restriction base="xsd:string">
      <xsd:minLength value="3"/>
      <xsd:maxLength value="254"/>
      <xsd:pattern value="[^@&apos;&lt;&gt;&quot;]+@[^@&apos;&lt;&gt;&quot;]+"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="SDLT_IRheaderStringType">
    <xsd:restriction base="xsd:string">
      <xsd:pattern value="[A-Za-z0-9 &amp;&apos;\(\)\*,\-\./]*"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="SDLT_ISOcurrencyType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="EUR">
        <xsd:annotation>
          <xsd:documentation>Euro</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="GBP">
        <xsd:annotation>
          <xsd:documentation>Sterling</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:complexType name="SDLT_TelephoneStructure">
    <xsd:sequence>
      <xsd:element minOccurs="1" maxOccurs="1" name="Number">
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:minLength value="1"/>
            <xsd:maxLength value="35"/>
            <xsd:pattern value="[0-9\(\)\-\s]{1,35}"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
      <xsd:element minOccurs="0" maxOccurs="1" name="Extension">
        <xsd:simpleType>
          <xsd:restriction base="xsd:string">
            <xsd:minLength value="1"/>
            <xsd:maxLength value="6"/>
            <xsd:pattern value="[0-9]{1,6}"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:element>
    </xsd:sequence>
    <xsd:attribute use="optional" name="Type" type="sdlt:SDLT_WorkHomeType"/>
    <xsd:attribute use="optional" name="Mobile" type="sdlt:SDLT_YesNoType"/>
    <xsd:attribute use="optional" name="Preferred" type="sdlt:SDLT_YesNoType"/>
  </xsd:complexType>
  <xsd:simpleType name="SDLT_WorkHomeType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="home"/>
      <xsd:enumeration value="work"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="SDLT_YesNoType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="no"/>
      <xsd:enumeration value="yes"/>
    </xsd:restriction>
  </xsd:simpleType>
  <!--
  **************************************************************
                    Auto-Generated Types
  **************************************************************

  Declaration of automatically generated named simpleTypes.
  These are necessary when XSDL does not allow inline
  declaration of simpleTypes under certain conditions.

  -->
  <xsd:simpleType name="_intermediate_SDLandArea">
    <xsd:restriction base="xsd:decimal">
      <xsd:pattern value="[0-9]+\.[0-9]{3}"/>
      <xsd:maxInclusive value="9999999999.999"/>
      <xsd:minInclusive value="0.000"/>
    </xsd:restriction>
  </xsd:simpleType>
</xsd:schema>
